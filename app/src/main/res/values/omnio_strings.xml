    <string name="omnio_about_tagline">Calls, contacts and messages in one app, with your people\'s chat apps and socials one tap away.</string>
    <string name="omnio_about_privacy">Privacy</string>
    <string name="omnio_about_privacy_1">Your contacts, calls and texts stay on your phone. Omnio One has no account, no tracking and no ads.</string>
    <string name="omnio_about_privacy_2">Internet is only used when you link a Facebook profile, to find its real address.</string>
    <string name="omnio_about_privacy_3">Screenshots you share to link a profile are read on your phone and never uploaded.</string>
    <string name="omnio_about_privacy_4">Link helper (optional) only looks at social apps, only while you\'re linking someone.</string>
