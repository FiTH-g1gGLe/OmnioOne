<?xml version="1.0" encoding="utf-8"?>
<!-- Omnio One Messages tab (Messages rewrite, stage 2) -->
<com.omnioone.app.fragments.OmnioMessagesTab xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messages_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <HorizontalScrollView
        android:id="@+id/messages_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/messages_filter_all"
                style="@style/OmnioChip"
                android:text="@string/omnio_filter_all" />

            <TextView
                android:id="@+id/messages_filter_unread"
                style="@style/OmnioChip"
                android:text="@string/omnio_filter_unread" />

            <TextView
                android:id="@+id/messages_filter_unknown"
                style="@style/OmnioChip"
                android:text="@string/omnio_filter_unknown" />

            <TextView
                android:id="@+id/messages_filter_groups"
                style="@style/OmnioChip"
                android:text="@string/omnio_filter_groups" />
        </LinearLayout>
    </HorizontalScrollView>

    <include
        android:id="@+id/messages_list"
        layout="@layout/omnio_contacts_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/messages_filters" />
</com.omnioone.app.fragments.OmnioMessagesTab>
