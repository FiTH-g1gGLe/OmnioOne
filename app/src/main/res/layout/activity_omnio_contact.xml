<?xml version="1.0" encoding="utf-8"?>
<!-- Omnio One contact page: photo, name, Call/Text/Edit, numbers, emails, birthday -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contact_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/contact_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_left_vector" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/contact_favourite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/favorites_tab"
                android:padding="12dp"
                android:src="@drawable/ic_star_outline_vector" />
        </LinearLayout>

        <ImageView
            android:id="@+id/contact_photo"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contact_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:gravity="center"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/contact_call"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:background="@drawable/omnio_round_bg"
                android:backgroundTint="@color/omnio_calls"
                android:drawableTop="@drawable/ic_phone_vector"
                android:gravity="center"
                android:paddingTop="14dp"
                android:text="@string/call"
                android:textColor="#FF0F1115"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contact_text"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/omnio_round_bg"
                android:backgroundTint="@color/omnio_messages"
                android:drawableTop="@drawable/ic_sms_vector"
                android:gravity="center"
                android:paddingTop="14dp"
                android:text="@string/omnio_text"
                android:textColor="#FF0F1115"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contact_edit"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/omnio_round_bg"
                android:backgroundTint="#FF1E232B"
                android:drawableTop="@drawable/ic_edit_vector"
                android:gravity="center"
                android:paddingTop="14dp"
                android:text="@string/edit"
                android:textColor="#FFECEFF4"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/contact_numbers_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:alpha="0.7"
            android:text="@string/omnio_numbers"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contact_numbers_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/omnio_round_bg"
            android:backgroundTint="#FF161A20"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/contact_details_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0.7"
            android:text="@string/omnio_details"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contact_details_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/omnio_round_bg"
            android:backgroundTint="#FF161A20"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
